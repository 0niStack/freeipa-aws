# Copy to .env and edit:  cp .env.example .env
IPA_DOMAIN=example.com
IPA_REALM=EXAMPLE.COM
IPA_HOSTNAME=ipa.example.com

# Leave empty: setup.sh auto-detects the EC2 private IP
IPA_IP=

# Leave as CHANGE_ME: setup.sh generates strong passwords and saves them here
IPA_ADMIN_PASSWORD=CHANGE_ME
IPA_DM_PASSWORD=CHANGE_ME

# Upstream DNS for non-IPA names: your router or a public resolver
IPA_FORWARDER=1.1.1.1

# Official image. Alternatives: almalinux-9, fedora-42, centos-9-stream
IPA_IMAGE=freeipa/freeipa-server:rocky-9
